rules_version = '2';

// Security rules for CarpenterHub.
//
// Admin status is a Firestore-collection allowlist (`admins/{uid}`),
// checked via exists() below, rather than a custom auth claim -- custom
// claims need a Cloud Function or the Admin SDK to set, both of which
// require the paid Blaze plan; this project intentionally stays on Spark
// (see the Cloudinary-instead-of-Storage note elsewhere in the repo).
// Admin accounts are provisioned by hand: create the Firebase Auth user
// in the Console, then add a doc at `admins/{that user's uid}` (content
// doesn't matter, only existence does). Never done through either app.
//
// Previously isAdmin() was just isSignedIn() -- meaning any authenticated
// user, including a carpenter who just self-registered in the mobile app,
// had admin-level write access to every collection below. Combined with
// admin_console's login screen auto-creating an account for whatever
// email/password was typed in, this meant anyone who found the public
// admin URL could grant themselves full write access with one login
// attempt. Both halves of that are now fixed (this file, and
// admin_console's login flow no longer auto-creates accounts).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(carpenterId) {
      return isSignedIn() && request.auth.uid == carpenterId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The order-creator role: can log party orders (below) but nothing else.
    function isOrderCreator() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/orderCreators/$(request.auth.uid));
    }

    // A user may check ONLY their own admin status (needed for the
    // client-side gate in admin_console) -- never list or read anyone
    // else's, and never write: admin status changes only via the
    // Console/Admin SDK, which bypass rules entirely.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Same self-read-only allowlist for the order-creator role.
    match /orderCreators/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Party orders: logged by an order-creator, reviewed/paid by an admin.
    // The carpenter app never touches this collection -- only the points
    // from each payment reach the carpenter (via pointsLedger, written by
    // the admin's transaction below, which isAdmin already gates).
    //   - order-creator: create their own; edit ONLY while still pending (so
    //     an admin's approval can't be edited out from under them); and, once
    //     approved, record payments against their own order -- collection is
    //     the creator's job, not the admin's.
    //   - admin: full read/write (approve, complete).
    match /partyOrders/{orderId} {
      allow read: if isAdmin() ||
        (isOrderCreator() && resource.data.createdBy == request.auth.uid);
      allow create: if isOrderCreator() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin() ||
        (isOrderCreator() &&
         resource.data.createdBy == request.auth.uid &&
         request.resource.data.createdBy == resource.data.createdBy &&
         (
           // Editing a still-pending order: it must stay pending -- the
           // creator can't flip status to 'approved' themselves.
           (resource.data.status == 'pending' && request.resource.data.status == 'pending') ||
           // Recording a payment on an approved order: only the payments
           // array may change, plus the status moving to 'completed' when
           // the final instalment settles it. The approved amount, reward
           // terms and ownership are all frozen at this point.
           (resource.data.status == 'approved' &&
            request.resource.data.status in ['approved', 'completed'] &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['payments', 'status']))
         ));
      allow delete: if isAdmin();
    }

    match /carpenters/{carpenterId} {
      allow read: if isSignedIn();
      allow create: if isOwner(carpenterId);
      // An order-creator recording a party payment credits points in the same
      // transaction, so it needs write access here -- but ONLY to the two
      // points fields. It can't touch status, tier, phone or anything else.
      allow update: if isOwner(carpenterId) || isAdmin() ||
        (isOrderCreator() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['points', 'lifetimePoints']));
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.carpenterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      // Per-order comment thread between the admin and the carpenter who
      // placed the order. Tighter than the parent order's read rule: only
      // the two participants can see it. Neither side can edit or delete
      // a comment after posting (admin aside), so the thread stays an
      // honest record on disputes.
      function isOrderOwner() {
        return isSignedIn() &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.carpenterId == request.auth.uid;
      }
      match /comments/{commentId} {
        allow read: if isAdmin() || isOrderOwner();
        allow create: if (isAdmin() && request.resource.data.authorRole == 'admin') ||
          (isOrderOwner() && request.resource.data.authorRole == 'carpenter');
        allow update, delete: if isAdmin();
      }
    }

    match /offers/{offerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /gifts/{giftId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /giftRedemptions/{redemptionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.carpenterId == request.auth.uid;
      allow update: if isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.carpenterId == request.auth.uid;
      allow update: if isAdmin();
    }

    // Problems carpenters report from the app's Feedback screen. A
    // carpenter may file their own and see their own; only the admin can
    // read the whole queue or change a row's status.
    match /feedback/{feedbackId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.carpenterId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.carpenterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Order-creators may only append (the ledger entry and notification that
    // accompany a party payment) -- never edit or delete existing rows.
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isOrderCreator();
      allow update, delete: if isAdmin();
    }

    match /pointsLedger/{entryId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isOrderCreator();
      allow update, delete: if isAdmin();
    }

    // Admin broadcast log (persisted notification-send history).
    match /broadcasts/{broadcastId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin-editable points/redeem rules, shared by both apps.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Atomic order-number counter. Carpenters bump this in a transaction
    // when creating an order, so it needs to be writable by any signed-in
    // user, not just admins.
    match /counters/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
  }
}
